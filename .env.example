# AIFENCE example configuration. Copy to .env for local development.
# All variables use the AIFENCE_ prefix; legacy SAGE_/AGENTDANCE_ names still work.

# --- core / lifecycle ---
AIFENCE_ENVIRONMENT=development
AIFENCE_RUNTIME_ROLE=control-plane
AIFENCE_LOG_LEVEL=INFO

# --- http surface ---
AIFENCE_BIND_HOST=0.0.0.0
AIFENCE_BIND_PORT=8080
AIFENCE_PUBLIC_BASE_URL=http://localhost:8080
AIFENCE_DOCS_ENABLED=true
# AIFENCE_ALLOWED_ORIGINS=https://app.example.com
# AIFENCE_ALLOWED_HOSTS=aifence.example.com
AIFENCE_MAX_REQUEST_BYTES=2097152

# --- persistence ---
AIFENCE_DATABASE_URL=sqlite+pysqlite:///./aifence.db
AIFENCE_DB_POOL_SIZE=20
AIFENCE_DB_MAX_OVERFLOW=20
AIFENCE_AUTO_CREATE_SCHEMA=true

# --- observability ---
AIFENCE_OTEL_SERVICE_NAME=aifence
# AIFENCE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AIFENCE_METRICS_PUBLIC=false
