{
  "name": "@aifence/client",
  "version": "1.0.0-rc.5",
  "description": "Official TypeScript client for AIFENCE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIFENCE/AIFENCE.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/AIFENCE/AIFENCE#readme",
  "bugs": {
    "url": "https://github.com/AIFENCE/AIFENCE/issues"
  },
  "keywords": [
    "ai-agents",
    "security",
    "policy",
    "capabilities",
    "audit"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
