{
  "$defs": {
    "Provenance": {
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "derivation": {
          "default": "direct",
          "title": "Derivation",
          "type": "string"
        },
        "observed_at": {
          "title": "Observed At",
          "type": "string"
        },
        "producer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "byte_size": {
      "minimum": 0,
      "title": "Byte Size",
      "type": "integer"
    },
    "digest": {
      "title": "Digest",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "media_type": {
      "default": "application/json",
      "title": "Media Type",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "ref": {
      "title": "Ref",
      "type": "string"
    },
    "tier": {
      "default": "warm",
      "enum": [
        "hot",
        "warm",
        "cold"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "ref",
    "byte_size",
    "digest"
  ],
  "title": "ProtocolRef",
  "type": "object"
}
