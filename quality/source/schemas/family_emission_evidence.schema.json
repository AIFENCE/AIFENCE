{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"BizIQ Family-Aware Emission Evidence",
  "type":"object",
  "additionalProperties":false,
  "required":["artifact_id","family","provenance","domain_terms","evidence_boundaries","surface_markers","semantics","status"],
  "properties":{
    "artifact_id":{"type":"string","minLength":1},
    "family":{"enum":["website","web-app","dashboard","mobile","brand","email","cli","presentation","spreadsheet","fixed-document","marketing-creative","composite","documentation"]},
    "provenance":{"const":"direct"},
    "domain_terms":{"type":"array","minItems":3,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "evidence_boundaries":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "surface_markers":{"type":"array","minItems":6,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "semantics":{
      "type":"object",
      "minProperties":2,
      "additionalProperties":{
        "type":"array",
        "minItems":1,
        "uniqueItems":true,
        "items":{"type":"string","minLength":2}
      }
    },
    "child_artifacts":{
      "type":"array",
      "minItems":2,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["artifact_id","family","surface_markers"],
        "properties":{
          "artifact_id":{"type":"string","minLength":1},
          "family":{"type":"string","minLength":2},
          "surface_markers":{"type":"array","minItems":3,"uniqueItems":true,"items":{"type":"string","minLength":3}}
        }
      }
    },
    "status":{"const":"PASS"}
  }
}
