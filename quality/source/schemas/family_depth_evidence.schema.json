{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIFENCE Family Depth Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "family",
    "provenance",
    "checks",
    "critical_dimensions",
    "records",
    "status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "enum": [
        "website",
        "mobile",
        "brand",
        "email",
        "cli",
        "composite"
      ]
    },
    "provenance": {
      "const": "direct"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNVERIFIED",
              "N/A"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "na_reason": {
            "type": "string"
          }
        }
      }
    },
    "critical_dimensions": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "requires_narrow_screen": {
      "type": "boolean",
      "default": false
    },
    "viewport_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "viewport",
          "overflow",
          "clipping",
          "critical_path_preserved",
          "evidence"
        ],
        "properties": {
          "viewport": {
            "type": "integer",
            "minimum": 240,
            "maximum": 4096
          },
          "overflow": {
            "type": "boolean"
          },
          "clipping": {
            "type": "boolean"
          },
          "critical_path_preserved": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "catastrophic_failures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ]
    }
  }
}
