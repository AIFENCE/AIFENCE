{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biziq://schemas/interaction_closure_manifest.schema.json",
  "title": "BizIQ Interaction Closure Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "controls",
    "tasks"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "expected_behavior",
          "enabled",
          "required_viewports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "expected_behavior": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "required_viewports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 240
            },
            "uniqueItems": true
          },
          "disabled_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "priority",
          "required_viewports",
          "completion_definition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "required_viewports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 240
            },
            "uniqueItems": true
          },
          "completion_definition": {
            "type": "string",
            "minLength": 1
          },
          "recovery_required": {
            "type": "boolean"
          },
          "desktop_surface": {
            "type": [
              "string",
              "null"
            ]
          },
          "mobile_equivalent": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "generated_before_final_acceptance": {
      "type": "boolean"
    }
  }
}
