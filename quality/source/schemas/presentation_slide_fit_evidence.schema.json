{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BizIQ Presentation Slide Fit Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "provenance",
    "slides",
    "status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "const": "direct"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide",
          "title_fits",
          "title_subtitle_overlap",
          "body_visual_overlap",
          "edge_clipping",
          "readable"
        ],
        "properties": {
          "slide": {
            "type": "integer",
            "minimum": 1
          },
          "title_fits": {
            "type": "boolean"
          },
          "title_subtitle_overlap": {
            "type": "boolean"
          },
          "body_visual_overlap": {
            "type": "boolean"
          },
          "edge_clipping": {
            "type": "boolean"
          },
          "readable": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "const": "PASS"
    }
  }
}
