{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AIFENCE Artifact Family Quality Evidence",
  "type":"object",
  "additionalProperties":false,
  "required":["artifact_id","artifact_family","provenance","checks","critical_dimensions","overall_score","status"],
  "properties":{
    "artifact_id":{"type":"string","minLength":1},
    "artifact_family":{"enum":["mobile","presentation","spreadsheet","fixed-document","brand","email","marketing-creative","cli","composite"]},
    "provenance":{"const":"direct"},
    "checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","status","evidence"],"properties":{"id":{"type":"string","minLength":1},"status":{"enum":["PASS","FAIL","UNVERIFIED","N/A"]},"evidence":{"type":"string","minLength":1},"na_reason":{"type":"string"}}}},
    "critical_dimensions":{"type":"object","minProperties":2,"additionalProperties":{"type":"number","minimum":0,"maximum":10}},
    "overall_score":{"type":"number","minimum":0,"maximum":100},
    "catastrophic_failures":{"type":"array","items":{"type":"string"},"default":[]},
    "status":{"enum":["PASS","FAIL","UNVERIFIED"]}
  }
}
