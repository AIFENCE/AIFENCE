{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biziq://schemas/artifact_acceptance.schema.json",
  "title": "BizIQ Artifact Acceptance",
  "type": "object",
  "required": [
    "artifact_id",
    "contract_ids",
    "dimension_states",
    "critical_failures",
    "overall_status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "contract_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dimension_states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNVERIFIED",
              "N/A"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "floor": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "critical_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "overall_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ]
    }
  },
  "additionalProperties": false
}
