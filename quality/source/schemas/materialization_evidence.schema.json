{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIFENCE Materialization Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id","family","provenance","records","user_facing_copy","checks","critical_dimensions","catastrophic_failures","status"],
  "properties": {
    "artifact_id": {"type":"string","minLength":1},
    "family": {"enum":["website","mobile","brand","email","cli","presentation","spreadsheet","fixed-document","marketing-creative","composite"]},
    "provenance": {"const":"direct"},
    "records": {
      "type":"array","minItems":2,
      "items":{"type":"object","additionalProperties":false,"required":["id","priority","user_job_or_decision","domain_need","artifact_surface","user_facing_material","action_or_state","truth_or_evidence_boundary","continuation_or_outcome"],"properties":{
        "id":{"type":"string","minLength":1},"priority":{"enum":["P0","P1","P2"]},
        "user_job_or_decision":{"type":"string","minLength":4},"domain_need":{"type":"string","minLength":4},"artifact_surface":{"type":"string","minLength":3},
        "user_facing_material":{"type":"string","minLength":4},"action_or_state":{"type":"string","minLength":3},
        "truth_or_evidence_boundary":{"type":"string","minLength":4},"continuation_or_outcome":{"type":"string","minLength":3},
        "specificity_marker":{"type":"string","minLength":4},"source_or_assumption":{"type":"string"}
      }}
    },
    "user_facing_copy":{"type":"array","minItems":2,"items":{"type":"string","minLength":2}},
    "checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","status","evidence"],"properties":{"id":{"type":"string","minLength":1},"status":{"enum":["PASS","FAIL","UNVERIFIED","N/A"]},"evidence":{"type":"string","minLength":1},"na_reason":{"type":"string"}}}},
    "critical_dimensions":{"type":"object","minProperties":2,"additionalProperties":{"type":"number","minimum":0,"maximum":10}},
    "catastrophic_failures":{"type":"array","items":{"type":"string"}},
    "status":{"enum":["PASS","FAIL","UNVERIFIED"]}
  }
}
