{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biziq://schemas/decision_depth_evidence.schema.json",
  "title": "BizIQ B2B Decision Depth Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "journey_type",
    "decision_paths",
    "rendered_or_direct_evidence",
    "status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_type": {
      "const": "b2b-complex"
    },
    "decision_paths": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "buyer_decision",
          "evidence_inputs",
          "fit_or_qualification",
          "objection_or_risk",
          "next_action",
          "downstream_state",
          "artifact_surface",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1"
            ]
          },
          "buyer_decision": {
            "type": "string",
            "minLength": 8
          },
          "evidence_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "fit_or_qualification": {
            "type": "string",
            "minLength": 3
          },
          "objection_or_risk": {
            "type": "string",
            "minLength": 3
          },
          "next_action": {
            "type": "string",
            "minLength": 3
          },
          "downstream_state": {
            "type": "string",
            "minLength": 3
          },
          "artifact_surface": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "const": "PASS"
          }
        }
      }
    },
    "rendered_or_direct_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ]
    }
  }
}
