{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AIFENCE Universal Executable Runtime Evidence",
  "type":"object",
  "additionalProperties":false,
  "required":["artifact_id","provenance","result","executions","runtime_errors"],
  "properties":{
    "artifact_id":{"type":"string","minLength":1},
    "provenance":{"const":"direct"},
    "result":{"enum":["PASS","FAIL"]},
    "executions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["label","command","exit_code","expected_exit_codes","stdout","stderr"],"properties":{
      "label":{"type":"string","minLength":1},"command":{"type":"string","minLength":1},"exit_code":{"type":"integer"},"expected_exit_codes":{"type":"array","minItems":1,"items":{"type":"integer"}},"stdout":{"type":"string"},"stderr":{"type":"string"}
    }}},
    "runtime_errors":{"type":"array","items":{"type":"string"}}
  }
}
