{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"BizIQ Emission Substance Evidence",
  "type":"object",
  "additionalProperties":false,
  "required":["artifact_id","family","provenance","domain_terms","decisions","actions","states","outcomes","evidence_boundaries","surface_markers","status"],
  "properties":{
    "artifact_id":{"type":"string","minLength":1},
    "family":{"enum":["website","web-app","dashboard","mobile","brand","email","cli","presentation","spreadsheet","fixed-document","marketing-creative","composite","documentation"]},
    "provenance":{"const":"direct"},
    "domain_terms":{"type":"array","minItems":3,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "decisions":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "actions":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "states":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "outcomes":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "evidence_boundaries":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "surface_markers":{"type":"array","minItems":8,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "status":{"const":"PASS"}
  }
}
