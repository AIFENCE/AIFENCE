{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biziq://schemas/role_accountability.schema.json",
  "title": "BizIQ Operational Role Accountability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role_id",
    "title",
    "purpose",
    "accountabilities",
    "scope_boundary",
    "inputs",
    "outputs",
    "decisions_owned",
    "exclusions"
  ],
  "properties": {
    "role_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "accountabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_boundary": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_owned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_recommended": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_duties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kpi_ownership": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
