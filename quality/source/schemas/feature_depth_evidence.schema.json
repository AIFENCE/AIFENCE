{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aifence://schemas/feature_depth_evidence.schema.json",
  "type": "object",
  "required": [
    "artifact_id",
    "features",
    "status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feature_id",
          "level",
          "user_job",
          "states_exercised",
          "responsive",
          "accessibility",
          "dependencies",
          "status"
        ]
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ]
    }
  },
  "additionalProperties": false
}
