{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aifence://schemas/responsive_composition.schema.json",
  "type": "object",
  "required": [
    "artifact_id",
    "viewports",
    "priority_map",
    "transformations",
    "status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 3
    },
    "priority_map": {
      "type": "object"
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ]
    }
  },
  "additionalProperties": false
}
