{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biziq://schemas/feature_spec.schema.json",
  "title": "BizIQ Feature Specification",
  "type": "object",
  "required": [
    "feature_id",
    "name",
    "purpose",
    "user_job",
    "priority",
    "information",
    "primary_action",
    "interaction_model",
    "states",
    "responsive_strategy",
    "accessibility",
    "truth_semantics",
    "dependencies",
    "acceptance_criteria"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "user_job": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "enum": [
        "primary",
        "secondary",
        "supporting",
        "utility",
        "contextual",
        "administrative"
      ]
    },
    "entry_point": {
      "type": [
        "string",
        "null"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "information": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "primary_action": {
      "type": "string",
      "minLength": 1
    },
    "secondary_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextual_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interaction_model": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "validation": {
      "type": [
        "string",
        "null"
      ]
    },
    "responsive_strategy": {
      "type": "string",
      "minLength": 1
    },
    "keyboard_behavior": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessibility": {
      "type": "string",
      "minLength": 1
    },
    "visual_treatment": {
      "type": [
        "string",
        "null"
      ]
    },
    "iconography": {
      "type": [
        "string",
        "null"
      ]
    },
    "contextual_help": {
      "type": [
        "string",
        "null"
      ]
    },
    "truth_semantics": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidence_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
