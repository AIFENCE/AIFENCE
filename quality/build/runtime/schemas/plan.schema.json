{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifence.local/runtime/plan.schema.json",
  "title": "AIFENCE Runtime Plan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "runtimeVersion",
    "coreRevision",
    "classification",
    "contextGraph",
    "riskGraph",
    "activeModules",
    "activeCapabilities",
    "activeDomains",
    "phases",
    "retrievalActions",
    "retrievalBudget",
    "qa"
  ],
  "properties": {
    "runtimeVersion": {
      "type": "string"
    },
    "coreRevision": {
      "type": "string"
    },
    "classification": {
      "type": "object"
    },
    "contextGraph": {
      "type": "object"
    },
    "riskGraph": {
      "type": "object"
    },
    "artifactContracts": {
      "type": "array"
    },
    "activeModules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activeCapabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capabilityId",
          "path",
          "phase"
        ],
        "properties": {
          "capabilityId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "activeDomains": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 31
      },
      "uniqueItems": true
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "activeCapabilities",
          "retrievalActions"
        ]
      }
    },
    "retrievalActions": {
      "type": "array"
    },
    "retrievalBudget": {
      "type": "object"
    },
    "evidencePlan": {
      "type": "array"
    },
    "qa": {
      "type": "array"
    },
    "unresolved": {
      "type": "array"
    },
    "interactionClosure": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "genericityClosure": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisionDepthClosure": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generationPreflight": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "denseProductQualityClosure": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
